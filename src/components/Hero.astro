---
import { hero, primaryPhone } from '../data/site'
---

{/*
  The fold has four jobs and no others: say what this is, say who it is for,
  offer one action, and defuse the first hesitation before it forms. The
  trust strip under the buttons is that last job — it answers "what does
  this cost me in effort and what breaks" without being asked.
*/}
<section id="top" class="relative overflow-hidden pt-28 pb-16 md:pt-36 md:pb-24">
  {/* Decorative ground: a warm wash and a faint grid that fades out. */}
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute left-1/2 top-[-24rem] h-[42rem] w-[80rem] -translate-x-1/2 rounded-full bg-brand-100/45 blur-3xl"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.045]"
      style="background-image: linear-gradient(to right, #100f0d 1px, transparent 1px), linear-gradient(to bottom, #100f0d 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse 75% 55% at 50% 0%, black 35%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 75% 55% at 50% 0%, black 35%, transparent 100%);"
    >
    </div>
  </div>

  <div class="container-page">
    <div class="mx-auto max-w-4xl text-center">
      <p
        class="reveal mb-7 inline-flex items-center gap-2.5 rounded-full border border-ink-200 bg-white/70 py-1.5 pl-2 pr-4 text-[0.8125rem] font-medium text-ink-700 backdrop-blur-sm"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-70"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-600"></span>
        </span>
        {hero.chip}
      </p>

      <h1 class="reveal display-1 font-display font-bold text-ink-950" data-reveal-delay="60">
        {hero.headline}
      </h1>

      <p
        class="reveal mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-ink-600 md:text-xl md:leading-relaxed"
        data-reveal-delay="120"
      >
        {hero.subhead}
      </p>

      <div
        class="reveal mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
        data-reveal-delay="180"
      >
        <a
          href="#demo"
          class="group inline-flex w-full items-center justify-center gap-2 rounded-full bg-ink-950 px-8 py-4 text-base font-semibold text-white shadow-lg shadow-ink-950/10 transition-all hover:bg-brand-700 hover:shadow-xl hover:shadow-brand-700/20 sm:w-auto"
        >
          {hero.primaryCta}
          <svg
            class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m0 0-6-6m6 6-6 6" />
          </svg>
        </a>
        <a
          href={`tel:${primaryPhone.raw}`}
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-ink-300 bg-white/60 px-8 py-4 text-base font-semibold text-ink-900 transition-all hover:border-ink-400 hover:bg-white sm:w-auto"
        >
          <svg class="h-4 w-4 text-brand-600" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
            />
          </svg>
          {hero.secondaryCta} {primaryPhone.display}
        </a>
      </div>

      <p class="reveal mt-5 text-sm text-ink-500" data-reveal-delay="220">{hero.reassurance}</p>

      {/* Trust strip. Four checkable facts, immediately under the action. */}
      <ul
        class="reveal mt-9 flex flex-wrap items-center justify-center gap-x-6 gap-y-2.5"
        data-reveal-delay="260"
      >
        {
          hero.trustStrip.map((item) => (
            <li class="flex items-center gap-2 text-[0.8125rem] font-medium text-ink-600">
              <svg
                class="h-3.5 w-3.5 shrink-0 text-brand-600"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    {/* Three concrete capabilities, phrased as outcomes rather than features. */}
    <ul class="reveal mx-auto mt-16 grid max-w-5xl gap-4 sm:grid-cols-3 md:mt-20" data-reveal-delay="300">
      {
        hero.highlights.map((item) => (
          <li class="rounded-2xl border border-ink-200/80 bg-white/70 p-6 text-left backdrop-blur-sm">
            <h2 class="font-display text-base font-bold text-ink-950">{item.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
