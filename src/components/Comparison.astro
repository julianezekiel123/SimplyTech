---
import SectionHeading from './SectionHeading.astro'
import { comparison } from '../data/site'

const { columns, rows } = comparison

// The last column is us, and it gets the emphasis treatment.
const oursIndex = columns.length - 1
---

{/*
  Answers "why not just do X instead" — the hesitation that kills deals
  silently, because nobody emails to ask it.

  The table is deliberately not a hatchet job. Voicemail genuinely handles
  unlimited simultaneous callers; a human receptionist genuinely knows your
  prices better than any assistant. Leaving those wins in place is what makes
  the rest of the column believable to somebody who has actually used them.
*/}
<section id="compare" class="border-y border-ink-200/70 bg-white py-24 md:py-32">
  <div class="container-page">
    <SectionHeading
      eyebrow={comparison.eyebrow}
      headline={comparison.headline}
      intro={comparison.intro}
      align="left"
    />

    {/* Scrolls inside itself on narrow screens rather than breaking the page. */}
    <div class="reveal mt-14 -mx-5 overflow-x-auto px-5 md:mx-0 md:px-0">
      <table class="w-full min-w-[46rem] border-collapse text-left">
        <caption class="sr-only">
          How voicemail, a receptionist, a traditional answering service and SimplyTech compare
          across eight capabilities.
        </caption>
        <thead>
          <tr>
            <th scope="col" class="w-[34%] pb-5 pr-6 align-bottom">
              <span class="sr-only">Capability</span>
            </th>
            {
              columns.map((col, i) => (
                <th
                  scope="col"
                  class:list={[
                    'pb-5 px-3 text-center align-bottom font-display text-sm font-bold md:text-base',
                    i === oursIndex ? 'text-ink-950' : 'text-ink-500',
                  ]}
                >
                  {i === oursIndex && (
                    <span class="mx-auto mb-2 block h-1 w-8 rounded-full bg-brand-600" aria-hidden="true" />
                  )}
                  {col}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class="border-t border-ink-200">
                <th
                  scope="row"
                  class="py-4 pr-6 text-sm font-medium leading-snug text-ink-800 md:text-[0.9375rem]"
                >
                  {row.label}
                </th>
                {row.values.map((value, i) => (
                  <td
                    class:list={[
                      'px-3 py-4 text-center',
                      i === oursIndex ? 'bg-brand-50/70' : '',
                    ]}
                  >
                    {/* Icon carries the meaning visually; the sr-only text
                        carries it for screen readers and for anyone whose
                        colour vision makes green-versus-grey unreliable. */}
                    {value === 'yes' && (
                      <>
                        <svg
                          class:list={[
                            'mx-auto h-5 w-5',
                            i === oursIndex ? 'text-brand-600' : 'text-ink-500',
                          ]}
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        <span class="sr-only">Yes</span>
                      </>
                    )}
                    {value === 'no' && (
                      <>
                        <svg
                          class="mx-auto h-5 w-5 text-ink-300"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path stroke-linecap="round" d="M6 18 18 6M6 6l12 12" />
                        </svg>
                        <span class="sr-only">No</span>
                      </>
                    )}
                    {value === 'partial' && (
                      <>
                        <svg
                          class="mx-auto h-5 w-5 text-ink-400"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path stroke-linecap="round" d="M6 12h12" />
                        </svg>
                        <span class="sr-only">Partly</span>
                      </>
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="reveal mx-auto mt-10 max-w-3xl text-center leading-relaxed text-ink-600">
      {comparison.footnote}
    </p>
  </div>
</section>
