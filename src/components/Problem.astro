---
import SectionHeading from './SectionHeading.astro'
import { problem } from '../data/site'
---

<section id="problem" class="bg-paper py-24 md:py-32">
  <div class="container-page">
    <SectionHeading
      eyebrow={problem.eyebrow}
      headline={problem.headline}
      intro={problem.intro}
      align="left"
    />

    {/* One-pixel gaps over an ink background give a hairline grid without
        four separate borders meeting at doubled thickness in the corners. */}
    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-ink-200 bg-ink-200 sm:grid-cols-2">
      {
        problem.pains.map((pain, i) => (
          <div class="reveal bg-white p-8 md:p-10" data-reveal-delay={i * 70}>
            <div class="flex items-start gap-4">
              <span
                class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-ink-100 font-display text-xs font-bold text-ink-500"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="font-display text-lg font-bold text-ink-950">{pain.title}</h3>
                <p class="mt-3 leading-relaxed text-ink-600">{pain.body}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
