---
import { company, primaryPhone } from '../data/site'

const mailto = `mailto:${company.email}?subject=${encodeURIComponent('Missed calls enquiry')}`
---

{/*
  Persistent action bar on phones only. Most of this page's traffic reads on
  a phone, and the decision to call rarely coincides with being near a button
  — so one is always within thumb reach.

  It hides itself while the footer call-to-action is on screen, so the two
  never stack up and argue with each other.
*/}
<div
  id="mobile-action-bar"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-ink-200 bg-paper/95 backdrop-blur-md transition-transform duration-300 lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="flex items-center gap-2.5 px-4 py-3">
    <a
      href={`tel:${primaryPhone.raw}`}
      class="flex flex-1 items-center justify-center gap-2 rounded-full bg-ink-950 px-4 py-3 text-sm font-semibold text-white"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
        />
      </svg>
      Call us
    </a>
    <a
      href={mailto}
      class="flex flex-1 items-center justify-center gap-2 rounded-full border border-ink-300 bg-white px-4 py-3 text-sm font-semibold text-ink-900"
    >
      <svg class="h-4 w-4 text-brand-600" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
        />
      </svg>
      Email us
    </a>
  </div>
</div>

<script>
  const bar = document.getElementById('mobile-action-bar')
  const finalCta = document.getElementById('contact')

  // Slide the bar out of the way once the reader reaches the footer CTA,
  // which already offers the same two actions at full size.
  if (bar && finalCta && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => bar.classList.toggle('translate-y-full', entry.isIntersecting),
      { threshold: 0.15 },
    )
    observer.observe(finalCta)
  }
</script>
