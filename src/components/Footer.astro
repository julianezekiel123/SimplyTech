---
import Logo from './Logo.astro'
import { company, nav } from '../data/site'

const year = new Date().getFullYear()

// Same reasoning as the header: bare hashes do nothing on /privacy or /terms.
const onHome = Astro.url.pathname === '/'
const to = (hash: string) => (onHome ? hash : `/${hash}`)
---

<footer class="border-t border-ink-200 bg-paper pb-24 pt-16 lg:pb-16">
  <div class="container-page">
    <div class="grid gap-12 md:grid-cols-[2fr_1fr_1.2fr]">
      <div>
        <a
          href={to('#top')}
          class="flex items-center gap-2.5 font-display text-[1.0625rem] font-bold tracking-tight text-ink-950"
        >
          <Logo class="h-8 w-8" />
          {company.name}
        </a>
        <p class="mt-4 max-w-sm leading-relaxed text-ink-600">{company.tagline}</p>
        <p class="mt-4 text-sm text-ink-500">Operated from {company.location}.</p>
      </div>

      <nav aria-label="Footer">
        <h2 class="eyebrow text-ink-400">Site</h2>
        <ul class="mt-4 space-y-3">
          {
            nav.map((link) => (
              <li>
                <a href={to(link.href)} class="text-sm text-ink-600 transition-colors hover:text-ink-950">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow text-ink-400">Contact</h2>
        <ul class="mt-4 space-y-3">
          <li>
            <a
              href={`mailto:${company.email}`}
              class="text-sm text-ink-600 transition-colors hover:text-ink-950"
            >
              {company.email}
            </a>
          </li>
          {
            company.phones.map((p) => (
              <li>
                <a
                  href={`tel:${p.raw}`}
                  class="text-sm text-ink-600 transition-colors hover:text-ink-950"
                >
                  {p.display}
                  <span class="ml-1.5 text-ink-400">({p.region})</span>
                </a>
              </li>
            ))
          }
          <li class="text-sm text-ink-500">{company.hours}</li>
          {
            company.linkedin && (
              <li>
                <a
                  href={company.linkedin}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="text-sm text-ink-600 transition-colors hover:text-ink-950"
                >
                  LinkedIn
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-ink-200 pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm text-ink-500">
        &copy; {year} {company.legalName}. All rights reserved.
      </p>
      <ul class="flex gap-6">
        <li><a href="/privacy" class="text-sm text-ink-500 hover:text-ink-900">Privacy</a></li>
        <li><a href="/terms" class="text-sm text-ink-500 hover:text-ink-900">Terms</a></li>
      </ul>
    </div>
  </div>
</footer>
