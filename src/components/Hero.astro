---
import { hero, primaryPhone } from '../data/site'
---

<section id="top" class="relative overflow-hidden bg-white pt-32 pb-20 md:pt-44 md:pb-28">
  {/* Background: a soft brand wash and a faint grid. Purely decorative. */}
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute left-1/2 top-[-18rem] h-[36rem] w-[72rem] -translate-x-1/2 rounded-full bg-brand-100/50 blur-3xl"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.035]"
      style="background-image: linear-gradient(to right, #0f1524 1px, transparent 1px), linear-gradient(to bottom, #0f1524 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, black 40%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 80% 55% at 50% 0%, black 40%, transparent 100%);"
    >
    </div>
  </div>

  <div class="container-page">
    <div class="mx-auto max-w-4xl text-center">
      <p class="reveal mb-6 inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white/80 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-ink-600">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-500" aria-hidden="true"></span>
        {hero.eyebrow}
      </p>

      <h1
        class="reveal font-display text-4xl font-extrabold leading-[1.08] text-ink-950 sm:text-5xl md:text-6xl lg:text-7xl"
        data-reveal-delay="60"
      >
        {hero.headline}
      </h1>

      <p
        class="reveal mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-ink-600 md:text-xl"
        data-reveal-delay="120"
      >
        {hero.subhead}
      </p>

      <div
        class="reveal mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
        data-reveal-delay="180"
      >
        <a
          href="#demo"
          class="group inline-flex w-full items-center justify-center gap-2 rounded-full bg-ink-950 px-8 py-4 text-base font-semibold text-white shadow-lg shadow-ink-950/10 transition-all hover:bg-brand-600 hover:shadow-xl hover:shadow-brand-600/20 sm:w-auto"
        >
          {hero.primaryCta}
          <svg
            class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16m0 0-6-6m6 6-6 6" />
          </svg>
        </a>
        <a
          href={`tel:${primaryPhone.raw}`}
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-ink-200 bg-white px-8 py-4 text-base font-semibold text-ink-900 transition-all hover:border-ink-300 hover:bg-ink-50 sm:w-auto"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
            />
          </svg>
          {hero.secondaryCta} {primaryPhone.display}
        </a>
      </div>

      <p class="reveal mt-5 text-sm text-ink-500" data-reveal-delay="220">{hero.reassurance}</p>
    </div>

    {/* Three concrete differentiators */}
    <ul
      class="reveal mx-auto mt-16 grid max-w-4xl gap-4 sm:grid-cols-3"
      data-reveal-delay="260"
    >
      {
        hero.highlights.map((item) => (
          <li class="flex items-start gap-3 rounded-2xl border border-ink-100 bg-white/70 p-5 text-left">
            <svg
              class="mt-0.5 h-5 w-5 shrink-0 text-brand-600"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            <span class="text-sm font-medium leading-snug text-ink-800">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
