---
import SectionHeading from './SectionHeading.astro'
import { demo, company, cta } from '../data/site'

const mailto = `mailto:${company.email}?subject=${encodeURIComponent('Live demo request')}&body=${encodeURIComponent(cta.emailBody)}`
---

<section id="demo" class="bg-white py-24 md:py-32">
  <div class="container-page">
    <SectionHeading
      eyebrow={demo.eyebrow}
      headline={demo.headline}
      intro={demo.intro}
    />

    <div class="mx-auto mt-14 grid max-w-5xl gap-6 lg:grid-cols-[1.3fr_1fr] lg:items-start">
      {/* Transcript */}
      <div class="reveal overflow-hidden rounded-3xl border border-ink-100 bg-ink-50/50">
        <div class="flex items-center gap-3 border-b border-ink-100 bg-white px-6 py-4">
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-60"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-brand-500"></span>
          </span>
          <p class="text-sm font-medium text-ink-600">{demo.scenario}</p>
        </div>

        <ol class="space-y-4 p-6 md:p-8">
          {
            demo.transcript.map((line) => (
              <li
                class:list={[
                  'flex',
                  line.speaker === 'assistant' ? 'justify-start' : 'justify-end',
                ]}
              >
                <div
                  class:list={[
                    'max-w-[85%] rounded-2xl px-5 py-3.5 text-sm leading-relaxed',
                    line.speaker === 'assistant'
                      ? 'rounded-tl-sm bg-ink-950 text-white'
                      : 'rounded-tr-sm border border-ink-200 bg-white text-ink-800',
                  ]}
                >
                  <p
                    class:list={[
                      'mb-1 text-[0.6875rem] font-bold uppercase tracking-[0.12em]',
                      line.speaker === 'assistant' ? 'text-brand-300' : 'text-ink-400',
                    ]}
                  >
                    {line.speaker === 'assistant' ? 'Assistant' : 'Caller'}
                  </p>
                  {line.text}
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      {/* What just happened */}
      <aside class="reveal rounded-3xl border border-ink-100 bg-white p-8" data-reveal-delay="100">
        <h3 class="font-display text-lg font-extrabold leading-snug text-ink-950">
          {demo.outcome.headline}
        </h3>

        <ul class="mt-6 space-y-4">
          {
            demo.outcome.points.map((point) => (
              <li class="flex items-start gap-3 text-sm leading-snug text-ink-700">
                <svg
                  class="mt-0.5 h-4 w-4 shrink-0 text-brand-500"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                {point}
              </li>
            ))
          }
        </ul>

        <a
          href={mailto}
          class="mt-8 flex items-center justify-center gap-2 rounded-full bg-ink-950 px-6 py-3.5 text-sm font-semibold text-white transition-all hover:bg-brand-600"
        >
          Hear it live on a call
        </a>
        <p class="mt-3 text-center text-xs text-ink-500">
          No public demo line — we run it with you directly.
        </p>
      </aside>
    </div>
  </div>
</section>
