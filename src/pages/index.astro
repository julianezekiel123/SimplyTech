---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Calculator from '../components/Calculator.astro'
import Problem from '../components/Problem.astro'
import Services from '../components/Services.astro'
import SampleCall from '../components/SampleCall.astro'
import Process from '../components/Process.astro'
import Commercials from '../components/Commercials.astro'
import About from '../components/About.astro'
import Faq from '../components/Faq.astro'
import Cta from '../components/Cta.astro'
---

<Base>
  {/*
    Order is deliberate, and built around having no clients yet.

    The calculator sits second, immediately after the hero, because it is the
    strongest thing on the page: it makes the visitor prove the problem to
    themselves using their own numbers, before we have asked them to believe
    anything about us.

    The transcript sits mid-page as the proof substitute — it answers "does it
    sound like a robot", which is the objection that kills this sale.

    Commercial terms come after the transcript, never before. Nobody cares what
    it costs until they believe it works.
  */}
  <Hero />
  <Calculator />
  <Problem />
  <Services />
  <SampleCall />
  <Process />
  <Commercials />
  <About />
  <Faq />
  <Cta />
</Base>
