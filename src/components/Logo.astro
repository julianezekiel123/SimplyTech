---
/**
 * The mark: a voice waveform inside a rounded tile.
 *
 * Deliberately geometric rather than illustrative, because it has to survive
 * being rendered at 16px in a browser tab. It is drawn as inline SVG rather
 * than an image file so it costs no request and inherits colour from CSS.
 *
 * Keep `public/favicon.svg` and `scripts/make-og-image.mjs` in step with this
 * if the shape ever changes.
 */
interface Props {
  class?: string
  tone?: 'dark' | 'light'
}

const { class: className = 'h-8 w-8', tone = 'dark' } = Astro.props

const tile = tone === 'dark' ? '#100f0d' : '#ffffff'
const bars = tone === 'dark' ? '#74bc96' : '#146845'
---

<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="8" fill={tile} />
  {/* Five bars rising and falling — a voice on a line, mid-sentence. */}
  <g fill={bars}>
    <rect x="5.3" y="13.5" width="2.6" height="5" rx="1.3" opacity="0.55" />
    <rect x="10" y="10" width="2.6" height="12" rx="1.3" />
    <rect x="14.7" y="7" width="2.6" height="18" rx="1.3" />
    <rect x="19.4" y="11" width="2.6" height="10" rx="1.3" />
    <rect x="24.1" y="13.5" width="2.6" height="5" rx="1.3" opacity="0.55" />
  </g>
</svg>
