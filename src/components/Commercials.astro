---
import SectionHeading from './SectionHeading.astro'
import { commercials, founding, showStartingPrice, startingPrice, company, cta } from '../data/site'

const mailto = `mailto:${company.email}?subject=${encodeURIComponent('Enquiry about working together')}&body=${encodeURIComponent(cta.emailBody)}`
---

{/*
  Terms come after the transcript, never before. Nobody cares what something
  costs until they believe it works.

  The dark panel at the bottom used to be an apology for being new. It now
  states the same facts — limited capacity, hands-on setup, we turn work down
  — as a deliberate way of operating, which is what they always were.
*/}
<section id="pricing" class="border-y border-ink-200/70 bg-white py-24 md:py-32">
  <div class="container-page">
    <SectionHeading
      eyebrow={commercials.eyebrow}
      headline={commercials.headline}
      intro={commercials.intro}
    />

    {
      showStartingPrice && startingPrice && (
        <p class="reveal mt-10 text-center">
          <span class="font-display text-5xl font-bold tracking-tight text-ink-950">
            {startingPrice}
          </span>
          <span class="ml-2 text-ink-500">per month, all in</span>
        </p>
      )
    }

    <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-ink-200 bg-ink-200 sm:grid-cols-2">
      {
        commercials.terms.map((term, i) => (
          <div class="reveal bg-paper p-8" data-reveal-delay={i * 70}>
            <h3 class="flex items-center gap-2.5 font-display text-base font-bold text-ink-950">
              <svg
                class="h-5 w-5 shrink-0 text-brand-600"
                fill="none"
                stroke="currentColor"
                stroke-width="2.25"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              {term.title}
            </h3>
            <p class="mt-3 leading-relaxed text-ink-600">{term.body}</p>
          </div>
        ))
      }
    </div>

    {/* How we work */}
    <div class="reveal mt-8 overflow-hidden rounded-2xl bg-ink-950 p-8 text-white md:p-12">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="h-px w-6 bg-brand-400" aria-hidden="true"></span>
            <p class="eyebrow text-brand-300">{founding.eyebrow}</p>
          </div>
          <h3 class="display-3 mt-5 font-display font-bold text-white">
            {founding.headline}
          </h3>
          <div class="mt-6 space-y-4">
            {founding.body.map((para) => <p class="leading-relaxed text-ink-300">{para}</p>)}
          </div>
        </div>

        <div class="lg:pt-16">
          <ul class="space-y-3.5">
            {
              founding.terms.map((term) => (
                <li class="flex items-start gap-3 text-sm leading-snug text-ink-200">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-brand-400"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                  {term}
                </li>
              ))
            }
          </ul>

          <a
            href={mailto}
            class="mt-8 flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-ink-950 transition-colors hover:bg-brand-100"
          >
            Ask about availability
          </a>
          <p class="mt-3 text-center text-xs text-ink-400">{founding.spotsNote}</p>
        </div>
      </div>
    </div>
  </div>
</section>
