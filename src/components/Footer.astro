---
import { company, nav } from '../data/site'

const year = new Date().getFullYear()
---

<footer class="border-t border-ink-100 bg-white py-16">
  <div class="container-page">
    <div class="grid gap-12 md:grid-cols-[2fr_1fr_1fr]">
      <div>
        <a href="#top" class="flex items-center gap-2 font-display text-lg font-extrabold tracking-tight text-ink-950">
          <span
            class="grid h-8 w-8 place-items-center rounded-lg bg-ink-950 font-display text-sm font-extrabold text-white"
            aria-hidden="true"
          >
            {company.name.charAt(0)}
          </span>
          {company.name}
        </a>
        <p class="mt-4 max-w-sm leading-relaxed text-ink-600">{company.tagline}</p>
      </div>

      <nav aria-label="Footer">
        <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-400">Site</h2>
        <ul class="mt-4 space-y-3">
          {
            nav.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-ink-600 transition-colors hover:text-ink-950">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-400">Contact</h2>
        <ul class="mt-4 space-y-3">
          <li>
            <a
              href={`mailto:${company.email}`}
              class="text-sm text-ink-600 transition-colors hover:text-ink-950"
            >
              {company.email}
            </a>
          </li>
          {
            company.phones.map((p) => (
              <li>
                <a
                  href={`tel:${p.raw}`}
                  class="text-sm text-ink-600 transition-colors hover:text-ink-950"
                >
                  {p.display}
                  <span class="ml-1.5 text-ink-400">({p.region})</span>
                </a>
              </li>
            ))
          }
          <li class="text-sm text-ink-500">{company.hours}</li>
          {
            company.linkedin && (
              <li>
                <a
                  href={company.linkedin}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="text-sm text-ink-600 transition-colors hover:text-ink-950"
                >
                  LinkedIn
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-ink-100 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-ink-500">
        &copy; {year} {company.legalName}. All rights reserved.
      </p>
      {/* TODO: add real privacy and terms pages before you run ads. Most ad
          platforms require a privacy policy, and GDPR applies if you contact
          anyone in the EU or UK. */}
      <ul class="flex gap-6">
        <li><a href="/privacy" class="text-sm text-ink-500 hover:text-ink-900">Privacy</a></li>
        <li><a href="/terms" class="text-sm text-ink-500 hover:text-ink-900">Terms</a></li>
      </ul>
    </div>
  </div>
</footer>
